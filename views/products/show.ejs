<%- include('../partials/header') %>

<div class="page-container">
  <div class="breadcrumb">
    <a href="/products"><i class="fas fa-store"></i> Shop</a>
    <span>›</span>
    <span><%= product.name %></span>
  </div>

  <div class="product-detail">
    <div class="product-detail-img">
      <img
        src="<%= product.image %>"
        alt="<%= product.name %>"
        onerror="this.src='/images/default-product.png'"
      />
    </div>

    <div class="product-detail-info">
      <span class="product-category product-category-large"><%= product.category %></span>
      <h1 class="product-detail-name"><%= product.name %></h1>
      <p class="product-detail-price">Rs. <%= product.price.toLocaleString() %></p>

      <div class="product-detail-stock">
        <% if (product.stock === 0) { %>
          <span class="stock-badge out-of-stock"><i class="fas fa-times-circle"></i> Out of Stock</span>
        <% } else if (product.stock <= 5) { %>
          <span class="stock-badge low-stock"><i class="fas fa-exclamation-circle"></i> Only <%= product.stock %> left!</span>
        <% } else { %>
          <span class="stock-badge in-stock"><i class="fas fa-check-circle"></i> In Stock (<%= product.stock %> available)</span>
        <% } %>
      </div>

      <div class="product-detail-desc">
        <h3>Description</h3>
        <p><%= product.description %></p>
      </div>

      <% if (currentUser && product.stock > 0) { %>
        <form action="/cart/add/<%= product._id %>" method="POST" class="add-to-cart-form">
          <div class="qty-selector">
            <label for="quantity">Quantity:</label>
            <input
              type="number"
              id="quantity"
              name="quantity"
              class="form-input qty-input"
              value="1"
              min="1"
              max="<%= product.stock %>"
            />
          </div>
          <button type="submit" class="btn btn-primary btn-large">
            <i class="fas fa-cart-plus"></i> Add to Cart
          </button>
        </form>
      <% } else if (!currentUser) { %>
        <div class="login-prompt">
          <a href="/auth/login" class="btn btn-primary btn-large">
            <i class="fas fa-sign-in-alt"></i> Login to Add to Cart
          </a>
        </div>
      <% } %>

      <% if (currentUser && currentUser.role === 'admin') { %>
        <div class="admin-actions">
          <h4><i class="fas fa-cog"></i> Admin Actions</h4>
          <a href="/products/<%= product._id %>/edit" class="btn btn-warning">
            <i class="fas fa-edit"></i> Edit Product
          </a>
          <form action="/products/<%= product._id %>?_method=DELETE" method="POST" style="display:inline;"
            onsubmit="return confirm('Are you sure you want to delete this product?')">
            <button type="submit" class="btn btn-danger">
              <i class="fas fa-trash"></i> Delete Product
            </button>
          </form>
        </div>
      <% } %>

      <p class="product-meta">Added by <%= product.createdBy ? product.createdBy.name : 'Admin' %></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
